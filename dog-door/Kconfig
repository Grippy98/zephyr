mainmenu "Dog Door"

menu "Dog Door application"

config DOG_DOOR_ACTUATOR_ARMED
	bool "Allow the firmware to energize the door stepper motor"
	help
	  Keep this disabled until the limit switches, motor phases, opening
	  direction, drive duty, step rate, and mechanical timeout are verified.

config DOG_DOOR_STEPPER_DRIVE_PERCENT
	int "Moving stepper PWM duty percentage"
	default 50
	range 10 100
	help
	  This board does not expose an adjustable 3D-printer-style current limit.
	  Start with a 6 V motor supply and increase this value only after checking
	  winding current and motor/driver temperature.

config DOG_DOOR_STEPPER_STEP_INTERVAL_US
	int "Delay between half-steps in microseconds"
	default 1250
	range 625 10000
	help
	  The default is 800 half-steps per second. Increase the interval to gain
	  low-speed torque or reduce it only after confirming reliable motion.

config DOG_DOOR_STEPPER_INVERT_DIRECTION
	bool "Reverse the stepper opening direction"
	help
	  Enable this if an open command moves the mechanism toward the lower
	  limit. Swapping either winding pair has the same physical effect.

config DOG_DOOR_TRAVEL_TIMEOUT_MS
	int "Maximum door travel time in milliseconds"
	default 30000
	range 1000 120000

config DOG_DOOR_LIMIT_DEBOUNCE_MS
	int "Limit switch debounce time in milliseconds"
	default 40
	range 10 500

config DOG_DOOR_SETUP_AP_SSID
	string "Provisioning access point SSID"
	default "DogDoor-Setup"

config DOG_DOOR_SETUP_AP_PASSWORD
	string "Provisioning access point password"
	default "configureme"
	help
	  Change this before deploying the device. WPA2 requires at least eight
	  characters.

config DOG_DOOR_HTTP_PORT
	int "HTTP server port"
	default 80
	range 1 65535

config DOG_DOOR_LOG_LEVEL
	int "Application log level"
	default 3
	range 0 4

endmenu

source "Kconfig.zephyr"
